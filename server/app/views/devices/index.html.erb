<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<% content_for :title, "Devices" %>

<h1>Devices</h1>

<div id="devices">
  <% @devices.each do |device| %>
    <%= render device %>
    <p>
      <%= link_to "Show this device", device %>
      <% if device.identity.present? %>
        · <%= button_to "Check for update", ota_check_device_path(device), method: :post, form: { style: "display: inline" } %>
      <% end %>
    </p>
  <% end %>
</div>

<%= link_to "New device", new_device_path %>
